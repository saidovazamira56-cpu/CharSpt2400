rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidChatSession(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             (!('model' in data) || (data.model is string && data.model.size() <= 100)) &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidChatMessage(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 100 &&
             data.sender is string && (data.sender == 'user' || data.sender == 'model' || data.sender == 'error') &&
             data.text is string && data.text.size() <= 100000 &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && incoming().userId == existing().userId && isValidUserProfile(incoming());
      allow delete: if isOwner(userId);

      match /sessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChatSession(incoming());
        allow update: if isOwner(userId) && incoming().userId == existing().userId && isValidChatSession(incoming());
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidChatMessage(incoming());
          allow update: if isOwner(userId) && incoming().userId == existing().userId && isValidChatMessage(incoming());
          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
