{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique Google user ID" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp created" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp updated" }
      },
      "required": ["userId", "displayName"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Chat session metadata",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Google user ID" },
        "title": { "type": "string", "description": "Title of the conversation" },
        "model": { "type": "string", "description": "Active model name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["userId", "title"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single chat message",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Google user ID" },
        "sessionId": { "type": "string", "description": "Associated session ID" },
        "sender": { "type": "string", "description": "Sender role: user, model, error" },
        "text": { "type": "string", "description": "Message content" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["userId", "sessionId", "sender", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile collection"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "User chat sessions"
    },
    "/users/{userId}/sessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "User session messages"
    }
  }
}
